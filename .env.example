# Khai Thien v3 — environment variables (EXAMPLE, do not put real secrets here)
# Copy to `.env` and fill in real values.

# REQUIRED: 32+ char random string used to encrypt Payload sessions/tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-secret-string

# PostgreSQL connection string (production / staging).
# Leave EMPTY to use local SQLite dev sandbox (file: ./khaithien_v3.db).
DATABASE_URL=

# Public site URL (used for absolute links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP (optional — contact form does not send email in dev)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
